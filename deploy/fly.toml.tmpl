# One Fly app per mesh node. Rendered by deploy/fly-deploy.sh.
app = "${APP}"
primary_region = "${REGION}"

[build]
  dockerfile = "../Dockerfile"

[env]
  NODE_ID = "${NODE_ID}"
  NODE_REGION = "${LABEL}"
  PUBLIC_ADDR = "0.0.0.0:8080"          # inside the VM; Fly's proxy terminates TLS on 443
  RAFT_ADDR = "fly-local-6pn:9080"      # Fly private network only, never in [[services]]
  PEERS = "${PEERS}"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  min_machines_running = 1

[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"
